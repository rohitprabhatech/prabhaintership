APP_ENV=development
APP_NAME=Prabha Internship Management API
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_management
DB_USER=app_user
DB_PASSWORD=CHANGE_ME
# Production must use separate least-privilege DB principals and a trusted CA.
# DB_SSL_CA=C:/path/to/mysql-ca.pem
# MIGRATION_DB_HOST=localhost
# MIGRATION_DB_PORT=3306
# MIGRATION_DB_NAME=internship_management
# MIGRATION_DB_USER=migration_user
# MIGRATION_DB_PASSWORD=CHANGE_ME
# ADMIN_PROVISIONING_DB_HOST=localhost
# ADMIN_PROVISIONING_DB_PORT=3306
# ADMIN_PROVISIONING_DB_NAME=internship_management
# ADMIN_PROVISIONING_DB_USER=admin_provisioner
# ADMIN_PROVISIONING_DB_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=prabhatech-internship-api
JWT_AUDIENCE=prabhatech-internship-admin
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:5173"]
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_BLOCK_SECONDS=300